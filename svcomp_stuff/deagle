def ensure_successful_unwind():
    with open("deagle_tmp_output", "r") as output:
        lines = output.readlines()
        for line in lines:
            if "Unwinding successfully" in line:
                return True
    return False

def check_result_normality(lines):
    if not lines:
        return False
    last_line = lines[-1]
    return "VERIFICATION SUCCESSFUL" in last_line or "VERIFICATION FAILED" in last_line

def is_unsupported_semantics_failure(line):
    """Recognize library-model limitations, not source-property failures."""
    return (
        ".precondition." in line
        and ": FAILURE" in line
        and "not yet supported" in line
    )

def inspect_result(path):
    """Classify a tool result without printing a provisional verdict."""
    with open(path, "r") as output:
        lines = output.readlines()
    if not check_result_normality(lines):
        return "ERROR"
    result = "SUCCESS"
    unsupported = False
    for line in lines:
        obj = re.match(r"\[(.*)\](.*): (.*)", line)
        if obj and obj.group(3) == "FAILURE":
            if is_unsupported_semantics_failure(line):
                unsupported = True
            else:
                result = "FAILURE"
    if result == "SUCCESS" and unsupported:
        return "UNKNOWN"
    return result

