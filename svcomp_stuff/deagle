limit_solverbound = 300
deagle_exe_path = os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "deagle_exe"
)
deagle_exe = shlex.quote(deagle_exe_path)

def ensure_successful_unwind():
    with open("deagle_tmp_output", "r") as output:
        lines = output.readlines()
        for line in lines:
            if "Unwinding successfully" in line:
                return True
    return False

def check_result_normality(lines):
    if not lines:
        return False
    last_line = lines[-1]
    return "VERIFICATION SUCCESSFUL" in last_line or "VERIFICATION FAILED" in last_line

def inspect_result(path):
    """Classify a tool result without printing a provisional verdict."""
    with open(path, "r") as output:
        lines = output.readlines()
    if not check_result_normality(lines):
        return "ERROR"
    result = "SUCCESS"
    for line in lines:
        obj = re.match(r"\[(.*)\](.*): (.*)", line)
        if obj and obj.group(3) == "FAILURE":
            result = "FAILURE"
    return result

def get_result(remove = True):
    result = "SUCCESS"
    with open("deagle_tmp_output", "r") as output:
        lines = output.readlines()
        if not check_result_normality(lines):
            return "ERROR"
        for line in lines:
            if (
                line.startswith("NATIVE_OBSERVABLE_DELTA_PROFILE ")
                or line.startswith("NATIVE_DISPATCH_PROFILE ")
                or line.startswith("NATIVE_ADAPTIVE_DISPATCH ")
                or line.startswith("NATIVE_PACKED_DELTA_SHADOW ")
                or line.startswith("NATIVE_RF_FIRST_BRANCHING ")
                or line.startswith("NATIVE_TRANSITION_WORD ")
                or line.startswith("NATIVE_COMMUTING_SEQUENTIALIZATION ")
                or line.startswith("NATIVE_JCES ")
                or line.startswith("NATIVE_PREFIX_AFFINE ")
                or line.startswith("NATIVE_TICKET_SERIALIZATION ")
                or line.startswith("NATIVE_LOCK_AGGREGATION ")
                or line.startswith("NATIVE_LOCK_STABILITY ")
                or line.startswith("NATIVE_CAS_STABILITY ")
                or line.startswith("NATIVE_PREDICATE_STABILITY ")
                or line.startswith("COUNTERFACTUAL_UIP_PROFILE ")
                or line.startswith("COUNTERFACTUAL_UIP_DOMAIN ")
                or line.startswith("COUNTERFACTUAL_UIP_DOMAIN_SOURCE ")
                or line.startswith("RF_PROPAGATION_UIP_PARTICIPATION ")
                or line.startswith("RF_PROPAGATION_EXACT_DOMAIN_SOURCE ")
                or line.startswith("RF_PROPAGATION_EXACT_DOMAIN_UIP ")
                or line.startswith("RF_PROPAGATION_CDCL_PATH_SOURCE ")
                or line.startswith("RF_PROPAGATION_CDCL_PATH_UIP ")
                or line.startswith("RF_MULTITARGET_WITNESS_SHADOW ")
                or line.startswith("RF_MULTITARGET_WITNESS_ONLINE ")
                or line.startswith("Deagle nondet bulk init: ")
                or line.startswith("ClosureSolver finishes with ")
                or re.match(r"^\d+ variables, \d+ clauses", line)
            ):
                print(line, end="")
            obj = re.match(r"\[(.*)\](.*): (.*)", line) # is a result line
            if not obj:
                continue
            new_result = obj.group(3)
            if new_result == "FAILURE" and result == "SUCCESS":
                result = "FAILURE"
            print(line,end="")
    print("Property: %s" % result)
    if(remove):
        os.system("rm deagle_tmp_output")
    return result

def get_loop_info(program_path, flags):
    cmd = "%s %s %s --unwind-suggest > deagle_tmp_unwind_suggest 2>&1" % (deagle_exe, program_path, flags)
    print(cmd)
    os.system(cmd)

    loops_name = []
    loops_limit = []
    is_onlystatic = True
    with open("deagle_tmp_unwind_suggest", "r") as output:
        lines = output.readlines()
        for i in range(len(lines)):
            obj = re.match(r"Loop (.+):", lines[i])
            if obj:
                loop_name = obj.group(1)
                loops_name.append(loop_name)
            
            obj = re.match(r"Suggested unwind limit: (\d+)", lines[i])
            if obj:
                loop_limit = int(obj.group(1))
                loops_limit.append(loop_limit)
                if loop_limit > limit_solverbound:
                    # When a loop's unwind limit can be determined but is too large
                    # We give up this verification task
                    # (otherwise TLE, wasting too much time)
                    print("Too large unwind limit: %d!" % loop_limit)
                    print("UNKNOWN")
                    sys.exit(0)
            
            obj = re.match(r"No suggested unwind limit", lines[i])
            if obj:
                loop_limit = 0
                loops_limit.append(loop_limit)
                is_onlystatic = False
            
    print(loops_name, loops_limit)
    os.system("rm deagle_tmp_unwind_suggest")
    return loops_name, loops_limit, is_onlystatic

def generate_unwindset(loops_name, loops_limit):
    unwindset = ""
    for loop_name, limit in zip(loops_name, loops_limit):
        unwindset += ("%s:%d," % (loop_name, limit))
    return unwindset

if len(sys.argv) < 2 or sys.argv[1] == "-v" or sys.argv[1] == "--version":
    print("4.1.0")
    sys.exit(0)

if sys.argv[1] == "--witness":
    print("Deagle is not a validator!")
    sys.exit(0)

if len(sys.argv) < 3:
    print("Usage: ./deagle property_path program_path")
    sys.exit(0)

property_path = sys.argv[1]
program_path = sys.argv[2]
if "unreach-call.prp" in property_path:
    with open(program_path, "r", errors="replace") as candidate_input:
        candidate_text = candidate_input.read()
    candidate_creates = len(
        re.findall(r"\bpthread_create\s*\(", candidate_text)
    )
    candidate_joins = len(
        re.findall(r"\bpthread_join\s*\(", candidate_text)
    )
    candidate_loop_worker = bool(
        re.search(
            r"\bvoid\s*\*\s*\w+\s*\([^;{}]*\)\s*\{.*?"
            r"\b(?:while|for)\s*\(",
            candidate_text,
            re.S,
        )
    )
    candidate_fold_shape = bool(
        "minus(" in candidate_text
        or "? -1" in candidate_text
        or re.search(
            r"\b\w+\s*=\s*\w+\s*\+\s*[^;]+;", candidate_text
        )
        or re.search(
            r"\w+\s*\[[^\]]+\]\s*==\s*"
            r"\w+\s*\[[^\]]+\]",
            candidate_text,
        )
    )
    candidate_joined_effect_shape = bool(
        candidate_creates >= 2
        and candidate_joins == candidate_creates
        and (
            "_Atomic" in candidate_text
            or "__VERIFIER_atomic_begin" in candidate_text
        )
        and re.search(
            r"assume_abort_if_not\s*\([^;]*(?:!=|==|<=|>=)[^;]*\)"
            r"\s*;\s*reach_error\s*\(\s*\)",
            candidate_text,
            re.S,
        )
    )
    if candidate_joined_effect_shape:
        try:
            import importlib.util
            import json

            effect_checker_path = os.path.join(
                os.path.dirname(os.path.abspath(__file__)),
                "joined_effect_checker.py",
            )
            effect_spec = importlib.util.spec_from_file_location(
                "joined_effect_checker", effect_checker_path
            )
            effect_checker = importlib.util.module_from_spec(effect_spec)
            effect_spec.loader.exec_module(effect_checker)
            effect_certificate = effect_checker.check(candidate_text)
        except Exception as exception:
            print(
                "Joined-region effect gate failed closed: %s" % exception,
                file=sys.stderr,
            )
            effect_certificate = {"result": "UNKNOWN"}
        if effect_certificate["result"] == "SAFE":
            print(
                "JOINED_EFFECT_CERTIFICATE "
                + json.dumps(
                    effect_certificate,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            print("VERIFICATION SUCCESSFUL")
            sys.exit(0)
    if (
        candidate_creates >= 3
        and candidate_joins >= 3
        and candidate_loop_worker
        and candidate_fold_shape
    ):
        try:
            import importlib.util
            import json

            checker_path = os.path.join(
                os.path.dirname(os.path.abspath(__file__)),
                "native_fold_checker.py",
            )
            checker_spec = importlib.util.spec_from_file_location(
                "native_fold_checker", checker_path
            )
            checker = importlib.util.module_from_spec(checker_spec)
            checker_spec.loader.exec_module(checker)
            certificate = checker.check(candidate_text)
        except Exception as exception:
            print(
                "Native relational-fold gate failed closed: %s"
                % exception,
                file=sys.stderr,
            )
            certificate = {"result": "UNKNOWN"}
        if certificate["result"] == "SAFE":
            print(
                "NATIVE_RELATIONAL_FOLD_CERTIFICATE "
                + json.dumps(
                    certificate, sort_keys=True, separators=(",", ":")
                )
            )
            print("VERIFICATION SUCCESSFUL")
            sys.exit(0)
    candidate_summary_shape = (
        (
            candidate_creates >= 3
            and candidate_joins >= 3
            and len(re.findall(r"\bfor\s*\(", candidate_text)) >= 3
            and re.search(
                r"\bfor\s*\([^;]*=\s*M\s*;", candidate_text
            )
        )
        or (
            candidate_creates >= 4
            and candidate_joins >= 4
            and len(re.findall(r"\bwhile\s*\(", candidate_text)) >= 4
            and re.search(
                r"\b[A-Za-z_]\w*_(?:front|back)\b", candidate_text
            )
        )
    )
    if candidate_summary_shape:
        try:
            import importlib.util
            import json

            segment_checker_path = os.path.join(
                os.path.dirname(os.path.abspath(__file__)),
                "stream_summary_checker.py",
            )
            segment_spec = importlib.util.spec_from_file_location(
                "stream_summary_checker", segment_checker_path
            )
            segment_checker = importlib.util.module_from_spec(segment_spec)
            segment_spec.loader.exec_module(segment_checker)
            segment_certificate = segment_checker.check(candidate_text)
        except Exception as exception:
            print(
                "Algebraic segment gate failed closed: %s" % exception,
                file=sys.stderr,
            )
            segment_certificate = {"result": "UNKNOWN"}
        if segment_certificate["result"] == "SAFE":
            print(
                "STREAM_SUMMARY_CERTIFICATE "
                + json.dumps(
                    segment_certificate,
                    sort_keys=True,
                    separators=(",", ":"),
                )
            )
            print("VERIFICATION SUCCESSFUL")
            sys.exit(0)
run_directory = tempfile.mkdtemp(prefix="deagle-")
atexit.register(shutil.rmtree, run_directory, ignore_errors=True)
os.chdir(run_directory)
base_flags = "--refined-pointer-analysis --graphml-witness error-witness.graphml "
force_experiment_direct = "--deagle-experiment-direct" in sys.argv[3:]
shallow_counterexample_prepass = (
    "--deagle-shallow-counterexample-prepass" in sys.argv[3:]
)
recursive_worker_prepass = (
    "--deagle-recursive-worker-prepass" in sys.argv[3:]
)
multi_template_worker_prepass = (
    "--deagle-multi-template-worker-prepass" in sys.argv[3:]
)
lock_ego_prepass = (
    "--deagle-lock-ego-prepass" in sys.argv[3:]
)
extra_args = [
    shlex.quote(arg) for arg in sys.argv[3:]
    if arg not in (
        "--deagle-experiment-direct",
        "--deagle-shallow-counterexample-prepass",
        "--deagle-recursive-worker-prepass",
        "--deagle-multi-template-worker-prepass",
        "--deagle-lock-ego-prepass",
    )
]
flags = base_flags + " ".join(extra_args) + " "
probe_args = [
    arg for arg in extra_args
    if arg not in (
        "--native-observable-delta-profile",
        "--native-dispatch-profile",
        "--native-indexed-dispatch",
        "--native-adaptive-indexed-dispatch",
        "--native-packed-delta-shadow",
        "--native-packed-delta",
        "--native-rf-first-branching",
        "--native-jces",
        "--native-guarded-rf-first-branching",
        "--native-ranked-rf-first-branching",
        "--native-closure-row-skip",
        "--native-linear-reason-merge",
        "--counterfactual-uip-profile",
        "--atomic-region-rf-transitive",
        "--counterfactual-uip-domain-profile",
        "--rf-propagation-uip-participation-profile",
        "--rf-propagation-exact-domain-uip-profile",
        "--rf-propagation-cdcl-path-uip-profile",
        "--rf-multitarget-witness-shadow",
        "--rf-multitarget-witness",
    )
]
probe_flags = base_flags + " ".join(probe_args) + " "

if "unreach-call.prp" in property_path:
    flags += ""
elif "no-data-race.prp" in property_path:
    flags += "--no-assertions --datarace "
elif "no-overflow.prp" in property_path:
    flags += "--no-assertions --signed-overflow-check --unsigned-overflow-check "
elif "valid-memsafety.prp" in property_path:
    flags += "--no-assertions --pointer-check --alloc-check --memory-leak-check"
else:
    print("Unknown property: %s" % property_path)
    sys.exit(0)

cached_loop_info = None
if multi_template_worker_prepass and "unreach-call.prp" in property_path:
    multi_template_filter = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "multi_create_loop_filter.awk",
    )
    multi_template_result = subprocess.run(
        ["awk", "-f", multi_template_filter, program_path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if multi_template_result.returncode == 0:
        cached_loop_info = get_loop_info(program_path, probe_flags)
        _, multi_template_limits, _ = cached_loop_info
        unwind_budget = 1
        finite_small_budget = bool(multi_template_limits)
        for limit in multi_template_limits:
            if limit <= 0:
                finite_small_budget = False
                break
            unwind_budget *= limit
            if unwind_budget > 64:
                finite_small_budget = False
                break
        if not finite_small_budget:
            multi_template_output = "deagle_tmp_multi_template_worker"
            multi_template_args = (
                [deagle_exe_path, program_path]
                + shlex.split(flags)
                + ["--interference-predicate-fixedpoint"]
            )
            try:
                with open(multi_template_output, "w") as output:
                    multi_template_proof = subprocess.run(
                        multi_template_args,
                        stdout=output,
                        stderr=subprocess.STDOUT,
                        timeout=2,
                        check=False,
                    )
            except subprocess.TimeoutExpired:
                multi_template_proof = None
            if (
                multi_template_proof is not None
                and multi_template_proof.returncode == 0
            ):
                with open(multi_template_output, "r") as output:
                    multi_template_lines = output.readlines()
                if any(
                    line.startswith(
                        "INTERFERENCE_PREDICATE_FIXEDPOINT result=SAFE"
                    )
                    for line in multi_template_lines
                ):
                    print("".join(multi_template_lines), end="")
                    print("VERIFICATION SUCCESSFUL")
                    sys.exit(0)

if recursive_worker_prepass and "unreach-call.prp" in property_path:
    lexical_filter = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "loop_create_filter.awk",
    )
    lexical_result = subprocess.run(
        ["awk", "-f", lexical_filter, program_path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if lexical_result.returncode == 0:
        recursive_output = "deagle_tmp_recursive_worker"
        recursive_args = (
            [deagle_exe_path, program_path]
            + shlex.split(flags)
            + ["--interference-predicate-recursive-worker-fixedpoint"]
        )
        try:
            with open(recursive_output, "w") as output:
                recursive_result = subprocess.run(
                    recursive_args,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    timeout=2,
                    check=False,
                )
        except subprocess.TimeoutExpired:
            recursive_result = None
        if recursive_result is not None and recursive_result.returncode == 0:
            with open(recursive_output, "r") as output:
                recursive_lines = output.readlines()
            if any(
                line.startswith(
                    "INTERFERENCE_PREDICATE_FIXEDPOINT result=SAFE"
                )
                for line in recursive_lines
            ):
                print("".join(recursive_lines), end="")
                print("VERIFICATION SUCCESSFUL")
                sys.exit(0)

if lock_ego_prepass and "unreach-call.prp" in property_path:
    lexical_filter = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "loop_create_filter.awk",
    )
    lexical_result = subprocess.run(
        ["awk", "-f", lexical_filter, program_path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if lexical_result.returncode == 0:
        ego_output = "deagle_tmp_lock_ego"
        ego_args = (
            [deagle_exe_path, program_path]
            + shlex.split(flags)
            + [
                "--native-lock-ego-abstraction",
                "--unwind",
                "16",
                "--unwinding-assertions",
            ]
        )
        try:
            with open(ego_output, "w") as output:
                ego_result = subprocess.run(
                    ego_args,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    timeout=5,
                    check=False,
                )
        except subprocess.TimeoutExpired:
            ego_result = None
        if ego_result is not None and ego_result.returncode == 0:
            with open(ego_output, "r") as output:
                ego_lines = output.readlines()
            if (
                any(
                    line.startswith(
                        "NATIVE_LOCK_EGO_ABSTRACTION applied=1"
                    )
                    for line in ego_lines
                )
                and any(
                    "VERIFICATION SUCCESSFUL" in line
                    for line in ego_lines
                )
            ):
                print("".join(ego_lines), end="")
                print("VERIFICATION SUCCESSFUL")
                sys.exit(0)

if cached_loop_info is None:
    loops_name, loops_limit, is_onlystatic = get_loop_info(
        program_path, probe_flags
    )
else:
    loops_name, loops_limit, is_onlystatic = cached_loop_info

if not loops_name:
    # No loops, run deagle_exe without any loop specification!
    print("No loops!")
    cmd = "%s %s %s > deagle_tmp_output 2>&1" % (deagle_exe, program_path, flags)
    print(cmd)
    os.system(cmd)
    result = get_result()
elif is_onlystatic:
    # All loops are static
    print("All loops can be statically determined!")
    unwindset = generate_unwindset(loops_name, loops_limit)
    cmd = "%s %s %s --unwindset %s > deagle_tmp_output 2>&1" % (deagle_exe, program_path, flags, unwindset)
    print(cmd)
    os.system(cmd)
    result = get_result()
elif force_experiment_direct:
    if shallow_counterexample_prepass:
        print("Trying a counterexample-only shallow prepass (bound 3, 2 s)!")
        prepass_args = (
            [deagle_exe_path, program_path]
            + shlex.split(flags)
            + ["--unwind", "3"]
        )
        try:
            with open("deagle_tmp_output", "w") as prepass_output:
                subprocess.run(
                    prepass_args,
                    stdout=prepass_output,
                    stderr=subprocess.STDOUT,
                    timeout=2,
                    check=False,
                )
        except subprocess.TimeoutExpired:
            print("Shallow prepass timed out; falling back to original Deagle.")

        prepass_result = inspect_result("deagle_tmp_output")
        if prepass_result == "FAILURE":
            print("Shallow prepass found a property violation.")
            result = get_result()
        else:
            print("Shallow prepass found no accepted violation; falling back.")
            os.remove("deagle_tmp_output")

    if shallow_counterexample_prepass and 'result' in locals():
        pass
    else:
        print("Experiment mode: bypass the wall-clock probe and run directly!")
        cmd = "%s %s %s > deagle_tmp_output 2>&1" % (deagle_exe, program_path, flags)
        print(cmd)
        os.system(cmd)
        result = get_result()
else:
    # Try whether this verification task is solvable without giving unwind limit
    try_cmd = "timeout 5 %s %s %s > deagle_tmp_output 2>&1" % (deagle_exe, program_path, probe_flags)
    print(try_cmd)
    os.system(try_cmd)
    try_result = get_result(False)
    if try_result == "SUCCESS" or try_result == "FAILURE":
        # Solvable in 5 seconds
        print("Solved within the single try!")
        result = try_result
    elif ensure_successful_unwind():
        # Not solved, but fully unwinded in 5 seconds
        print("Not solved within the single try, but at least unwinding is successful!")
        cmd = "%s %s %s > deagle_tmp_output 2>&1" % (deagle_exe, program_path, flags)
        print(cmd)
        os.system(cmd)
        result = get_result()
        
    else:
        # Let undetermined loops unwind 3 times
        print("The bound of loops is not determined!")
        
        undetermine_limit = 3
        loops_limit_it = [loop_limit if loop_limit else undetermine_limit for loop_limit in loops_limit]
        unwindset = generate_unwindset(loops_name, loops_limit_it)
        cmd = "%s %s %s --unwindset %s > deagle_tmp_output 2>&1" % (deagle_exe, program_path, flags, unwindset)
        
        print("\nUnwindset: %s" % unwindset)
        print(cmd)
        os.system(cmd)
        result = get_result()

if result == "SUCCESS":
    print("SUCCESSFUL")
    sys.exit(0)
elif result == "FAILURE":
    print("FAILED")
    sys.exit(0)
else:
    print(result)
    sys.exit(1)
