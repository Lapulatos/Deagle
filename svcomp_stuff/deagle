def try_large_limit_native_proof(program_path, flags):
    proof_args = (
        [deagle_exe_path, program_path]
        + shlex.split(flags)
        + [
            "--native-pair-initialization-prefix",
            "--native-jces",
            "--unwind",
            "2",
            "--no-unwinding-assertions",
        ]
    )
    proof_output = "deagle_tmp_large_limit_native_proof"
    with open(proof_output, "w") as output:
        process = subprocess.Popen(
            proof_args,
            stdout=output,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        try:
            returncode = process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
            return False
    if returncode != 0:
        return False
    with open(proof_output, "r") as output:
        lines = output.readlines()
    accepted_markers = (
        "NATIVE_BOOLEAN_ATOMIC_LOCK_REGION applied=1 ",
        "NATIVE_NESTED_LAST_WRITER applied=1 ",
        "NATIVE_MUTEX_ZERO_FIXEDPOINT applied=1 ",
        "NATIVE_AGGREGATE_MEMBER_LOCK_ALIAS applied=1 ",
        "NATIVE_RESOLVED_WORKER_ZERO_SUM applied=1 ",
        "NATIVE_MONOTONE_CONDITION_WAIT applied=1 ",
        "NATIVE_GUARDED_COMMON_MUTEX_ZERO_SUM applied=1 ",
        "NATIVE_COMMON_MUTEX_ZERO_SUM applied=1 ",
        "NATIVE_RELATIONAL_BISIMULATION applied=1 ",
        "NATIVE_LOCK_RELATIONAL_AI applied=1 ",
        "NATIVE_PARTITIONED_COUNT_REDUCTION applied=1 ",
        "NATIVE_FINITE_TWO_SIDED_DISJUNCTION applied=1 ",
        "NATIVE_COMPLETION_FLAG_ARITHMETIC applied=1 ",
        "NATIVE_NONZERO_CAS_SEED applied=1 ",
        "NATIVE_MONOTONE_CHUNK_MAXIMUM applied=1 ",
        "NATIVE_LINEAR_TILED_COPY_EQUIVALENCE applied=1 ",
        "NATIVE_ATOMIC_QUEUE_OCCUPANCY_VALUE applied=1 ",
        "NATIVE_ISOMORPHIC_MODULAR_FOLD_PAIR applied=1 ",
    )
    marker = next(
        (
            line
            for line in lines
            if line.startswith(accepted_markers)
        ),
        None,
    )
    if marker is None or not any(
        "VERIFICATION SUCCESSFUL" in line for line in lines
    ):
        return False
    print(marker, end="")
    print("VERIFICATION SUCCESSFUL")
    return True


def try_complete_small_bound(program_path, flags, unwind):
    """Route a fixed small loop bound to Deagle; Deagle proves completeness."""
    output_path = "deagle_tmp_complete_small_bound"
    proof_args = (
        [deagle_exe_path, program_path]
        + shlex.split(flags)
        + ["--unwind", str(unwind), "--unwinding-assertions"]
    )
    try:
        with open(output_path, "w") as output:
            result = subprocess.run(
                proof_args,
                stdout=output,
                stderr=subprocess.STDOUT,
                timeout=2,
                check=False,
            )
    except subprocess.TimeoutExpired:
        return False
    with open(output_path, "r") as output:
        lines = output.readlines()
    if (
        result.returncode not in (0, 10)
        or not check_result_normality(lines)
    ):
        return False
    print("".join(lines), end="")
    return True


def condition_wait_routing_candidate(program_path):
    """Cheap routing only; the native implementation makes the proof decision."""
    try:
        source = pathlib.Path(program_path).read_text(
            encoding="utf-8",
            errors="ignore",
        )
    except OSError:
        return False
    required_tokens = (
        "pthread_cond_wait",
        "pthread_cond_broadcast",
        "pthread_mutex_lock",
        "pthread_mutex_unlock",
    )
    return all(token in source for token in required_tokens)

def native_structural_proof_routing_candidate(program_path):
    """Shallow routing only; deagle_exe checks every semantic obligation."""
    try:
        source = pathlib.Path(program_path).read_text(
            encoding="utf-8",
            errors="ignore",
        )
    except OSError:
        return False
    signatures = (
        ("count = count + local_count;", "iterations = 1000/num_threads;"),
        ("myArea += (four /", "area - 3.141592653883724"),
        ("total = total + j;", "if (flag)"),
        ("__VERIFIER_atomic_CAS(&seed", "int cond = seed != 0;"),
        (
            "int my_max = 0x80000000;",
            "volatile int max = 0x80000000;",
            "offset % 2 == 0",
        ),
        ("B[i][j] = F[i*M+j];", "A[a*M+b] != B[a][b]"),
        (
            "queue[front + size] == 5",
            "x = queue[front];",
            "assume_abort_if_not(x != 5)",
        ),
        (
            "x = x + B;",
            "end == start + 2",
            "queue[start] == queue[start+1]",
            "assume_abort_if_not(!ok)",
        ),
    )
    return any(all(token in source for token in signature)
               for signature in signatures)


def get_loop_info(
    program_path,
    flags,
    native_proof_flags=None,
    protocol_capacity=False,
):
    fused_flag = (
        " --protocol-induced-capacity-cutoff"
        if protocol_capacity
        else ""
    )
    cmd = (
        "%s %s %s --unwind-suggest%s "
        "> deagle_tmp_unwind_suggest 2>&1"
        % (deagle_exe, program_path, flags, fused_flag)
    )
    print(cmd)
    os.system(cmd)

    loops_name = []
    loops_limit = []
    is_onlystatic = True
    large_unwind_limit = None
    with open("deagle_tmp_unwind_suggest", "r") as output:
        lines = output.readlines()
        protocol_marker = next(
            (
                line
                for line in lines
                if line.startswith(
                    "PROTOCOL_CAPACITY_CUTOFF result=SAFE"
                )
            ),
            None,
        )
        if protocol_marker is not None and any(
            "VERIFICATION SUCCESSFUL" in line for line in lines
        ):
            print(protocol_marker, end="")
            print("VERIFICATION SUCCESSFUL")
            sys.exit(0)
        for i in range(len(lines)):
            obj = re.match(r"Loop (.+):", lines[i])
            if obj:
                loop_name = obj.group(1)
                loops_name.append(loop_name)
            
            obj = re.match(r"Suggested unwind limit: (\d+)", lines[i])
            if obj:
                loop_limit = int(obj.group(1))
                loops_limit.append(loop_limit)
                if loop_limit > limit_solverbound:
                    # When a loop's unwind limit can be determined but is too large
                    # Try a bounded-cost semantic proof before preserving the
                    # original UNKNOWN result.
                    if (
                        native_proof_flags is not None
                        and try_large_limit_native_proof(
                            program_path, native_proof_flags
                        )
                    ):
                        sys.exit(0)
                    if (
                        large_unwind_limit is None
                        or loop_limit > large_unwind_limit
                    ):
                        large_unwind_limit = loop_limit
            
            obj = re.match(r"No suggested unwind limit", lines[i])
            if obj:
                loop_limit = 0
                loops_limit.append(loop_limit)
                is_onlystatic = False
            
    print(loops_name, loops_limit)
    os.system("rm deagle_tmp_unwind_suggest")
    return loops_name, loops_limit, is_onlystatic, large_unwind_limit


def try_large_unwind_counterexample_rescue(program_path, flags):
    print(
        "Trying unified native counterexample rescue "
        "(native portfolio, up to 96 s)!",
        flush=True,
    )
    rescue_flag_args = [
        arg
        for arg in shlex.split(flags)
        if arg != "--refined-pointer-analysis"
    ]
    rescue_args = (
        [deagle_exe_path, program_path]
        + rescue_flag_args
        + [
            "--unwind",
            "3",
            "--native-counterexample-rescue-portfolio",
        ]
    )
    try:
        with open("deagle_tmp_output", "w") as rescue_output:
            subprocess.run(
                rescue_args,
                stdout=rescue_output,
                stderr=subprocess.STDOUT,
                timeout=96,
                check=False,
            )
    except subprocess.TimeoutExpired:
        print(
            "Unified native counterexample rescue timed out.",
            flush=True,
        )
    rescue_result = inspect_result("deagle_tmp_output")
    if rescue_result == "FAILURE":
        print(
            "Unified native counterexample rescue found a property violation.",
            flush=True,
        )
        return get_result()
    print(
        "Unified native counterexample rescue found no accepted violation.",
        flush=True,
    )
    os.remove("deagle_tmp_output")
    return None

def generate_unwindset(loops_name, loops_limit):
    unwindset = ""
    for loop_name, limit in zip(loops_name, loops_limit):
        unwindset += ("%s:%d," % (loop_name, limit))
    return unwindset

