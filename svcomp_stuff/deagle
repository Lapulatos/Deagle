if multi_template_worker_prepass and "unreach-call.prp" in property_path:
    multi_template_filter = os.path.join(
        os.path.dirname(os.path.abspath(__file__)),
        "multi_create_loop_filter.awk",
    )
    multi_template_result = subprocess.run(
        ["awk", "-f", multi_template_filter, program_path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    run_multi_template_fixedpoint = False
    if multi_template_result.returncode == 0:
        cached_loop_info = get_loop_info(
            program_path,
            probe_flags,
            flags,
            protocol_capacity_prepass,
        )
        _, multi_template_limits, _, _ = cached_loop_info
        unwind_budget = 1
        finite_small_budget = bool(multi_template_limits)
        for limit in multi_template_limits:
            if limit <= 0:
                finite_small_budget = False
                break
            unwind_budget *= limit
            if unwind_budget > 64:
                finite_small_budget = False
                break
        run_multi_template_fixedpoint = not finite_small_budget
    run_multi_template_fixedpoint = bool(
        run_multi_template_fixedpoint
        or candidate_guarded_affine
        or candidate_error_control_wp
        or candidate_finite_protocol_product
    )
    if run_multi_template_fixedpoint:
        multi_template_output = "deagle_tmp_multi_template_worker"
