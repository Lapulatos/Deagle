            multi_template_environment["DEAGLE_WP_MAX_DEPTH"] = "2"
        elif candidate_guarded_affine:
            multi_template_environment["DEAGLE_AFFINE_MODE"] = "1"
        try:
            with open(multi_template_output, "w") as output:
                multi_template_proof = subprocess.run(
                    multi_template_args,
                    env=multi_template_environment,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    timeout=5
